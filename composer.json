{
    "name": "balismatz/laravel-image-style",
    "description": "A Laravel package for managing application image styles in a simple and organized way.",
    "keywords": [
        "laravel",
        "image",
        "image styles"
    ],
    "license": "MIT",
    "autoload": {
        "files": [
            "helpers.php"
        ],
        "psr-4": {
            "BalisMatz\\ImageStyle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BalisMatz\\ImageStyle\\Tests\\": "tests/",
            "App\\": "vendor/orchestra/testbench-core/laravel/app"
        }
    },
    "support": {
        "issues": "https://github.com/balismatz/laravel-image-style/issues",
        "source": "https://github.com/balismatz/laravel-image-style"
    },
    "authors": [
        {
            "name": "Balis Matzouranis",
            "email": "balis.matz@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.20",
        "intervention/image": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2",
        "orchestra/testbench": "^11.2",
        "laravel/pint": "^1.30"
    },
    "extra": {
        "laravel": {
            "providers": [
                "BalisMatz\\ImageStyle\\ImageStyleServiceProvider"
            ],
            "aliases": {
                "ImageStyle": "BalisMatz\\ImageStyle\\Facades\\ImageStyle"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "check": [
            "pint",
            "phpstan",
            "phpunit"
        ]
    }
}
